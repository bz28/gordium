<Project Sdk="Microsoft.NET.Sdk">
  <!-- PROTOTYPE, render-only (Ben, 2026-11-22: design first, approval before anything ships). Draws the results
       pane off-screen, today's (the add-in's own view files, linked unchanged) and the proposed (Proposed/, copies
       of those files with the proposed changes), fed by real checker answers, to PNGs. It is not the add-in: no
       ribbon command opens it, Revit never loads it, and nothing here is in Gordium.Worker.slnx or CI. It needs
       Revit 2027 installed only because the linked view files name Revit's types (they are never called).
       Run: dotnet run -c Release -p:TreatWarningsAsErrors=false - - <fixtures dir> <out dir> -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks></TargetFrameworks>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>Gordium.Revit.PanePrototype</RootNamespace>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <RevitDir>$(ProgramW6432)\Autodesk\Revit 2027</RevitDir>
    <DefineConstants>$(DefineConstants);REVIT2027</DefineConstants>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="RevitAPI" HintPath="$(RevitDir)\RevitAPI.dll" Private="false" />
    <Reference Include="RevitAPIUI" HintPath="$(RevitDir)\RevitAPIUI.dll" Private="false" />
    <ProjectReference Include="../../src/Gordium.Worker/Gordium.Worker.csproj" />
    <ProjectReference Include="../../src/Gordium.Revit.Reading/Gordium.Revit.Reading.csproj" />
  </ItemGroup>
  <ItemGroup Label="today: the add-in's own view files, unchanged">
    <Compile Include="../../src/Gordium.Revit.Addin/ResultsView.cs" Link="Today/ResultsView.cs" />
    <Compile Include="../../src/Gordium.Revit.Addin/ResultsList.cs" Link="Today/ResultsList.cs" />
    <Compile Include="../../src/Gordium.Revit.Addin/CauseCardsView.cs" Link="Today/CauseCardsView.cs" />
    <Compile Include="../../src/Gordium.Revit.Addin/DetailView.cs" Link="Today/DetailView.cs" />
    <Compile Include="../../src/Gordium.Revit.Addin/SetupView.cs" Link="Today/SetupView.cs" />
    <Compile Include="../../src/Gordium.Revit.Addin/PanelLook.cs" Link="Today/PanelLook.cs" />
    <Page Remove="**/*.xaml" />
    <EmbeddedResource Include="../../src/Gordium.Revit.Addin/PanelStyles.xaml" LogicalName="Gordium.Revit.Addin.PanelStyles.xaml" Link="Today/PanelStyles.xaml" />
  </ItemGroup>
  <ItemGroup Label="proposed: copies of those files with the proposed changes (diff them against src/Gordium.Revit.Addin)">
    <EmbeddedResource Include="Proposed/PanelStyles.xaml" LogicalName="Gordium.Revit.PanePrototype.Proposed.PanelStyles.xaml" />
  </ItemGroup>
</Project>
