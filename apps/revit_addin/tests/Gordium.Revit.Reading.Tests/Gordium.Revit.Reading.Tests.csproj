<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="[17.14.1]" />
    <PackageReference Include="xunit" Version="[2.9.3]" />
    <PackageReference Include="xunit.runner.visualstudio" Version="[3.1.4]" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Gordium.Revit.Reading/Gordium.Revit.Reading.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="scene_data.py;check_recording.py" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- the four-unit apartment's answer is made, never committed (it changes with almost every rule): a build
       without it stops and says how to make it, rather than tests failing on a missing file -->
  <Target Name="GordiumApartmentAnswerMade" BeforeTargets="Build"
          Condition="!Exists('$(MSBuildThisFileDirectory)answers/four_unit_apartment_check_answer.json')">
    <Error Text="Make the pane's apartment answer first, from the repository folder: python apps/revit_addin/tools/evals/make_apartment_answer.py (apps/revit_addin/README.md)" />
  </Target>
</Project>
