<Project Sdk="Microsoft.NET.Sdk">
  <!-- Talks to Gordium's Python worker (docs/protocol/worker_protocol_v1.md). No Revit API and no packages:
       System.Text.Json comes with .NET. -->
  <PropertyGroup>
    <RootNamespace>Gordium.Worker</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- the public types and members are documented; their constructors and enum values speak for themselves -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- the tests check the strict reader directly, case by case -->
    <InternalsVisibleTo Include="Gordium.Worker.Tests" />
    <!-- and the Revit reader's, which read answers made by hand into the dialog's words (ResultTextTests) -->
    <InternalsVisibleTo Include="Gordium.Revit.Reading.Tests" />
  </ItemGroup>
</Project>
