<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Revit reader's decisions (docs/revit/revit_reading_design.md), over plain records of what the Revit layer
       reads from a model (Records.cs). No Revit API and no packages: the thin Revit layer (Windows, later) fills the
       records; everything here is built and tested on the Mac. -->
  <PropertyGroup>
    <RootNamespace>Gordium.Revit.Reading</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Gordium.Revit.Reading.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Gordium.Worker/Gordium.Worker.csproj" />
  </ItemGroup>
</Project>
