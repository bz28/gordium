<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Revit add-in itself: the ribbon buttons and the thin layer over the Revit API. It needs Revit's own
       RevitAPI.dll and RevitAPIUI.dll, so it builds only on a Windows machine with Revit installed, and it is not
       in Gordium.Worker.slnx (CI and the Mac build and test everything else). One build per Revit version:
       net10.0-windows against Revit 2027, net8.0-windows against Revit 2026 (each only where that Revit is
       installed). docs/revit/windows_trial_runbook.md, days 3 and 4. -->
  <PropertyGroup>
    <TargetFrameworks Condition="Exists('$(ProgramW6432)\Autodesk\Revit 2027\RevitAPI.dll')">net10.0-windows</TargetFrameworks>
    <TargetFrameworks Condition="Exists('$(ProgramW6432)\Autodesk\Revit 2026\RevitAPI.dll')">$(TargetFrameworks);net8.0-windows</TargetFrameworks>
    <RootNamespace>Gordium.Revit.Addin</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Revit's API is built on WPF and Windows Forms: without them the build warns that WindowsBase, System.Drawing and friends conflict (MSB3277) -->
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- Revit loads the add-in's own dependencies from its folder: copy Gordium.Worker beside it -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <RevitVersion>2027</RevitVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <RevitVersion>2026</RevitVersion>
  </PropertyGroup>
  <PropertyGroup>
    <RevitDir>$(ProgramW6432)\Autodesk\Revit $(RevitVersion)</RevitDir>
    <DefineConstants>$(DefineConstants);REVIT$(RevitVersion)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <!-- Revit's own assemblies: referenced, never copied (Revit already has them loaded) -->
    <Reference Include="RevitAPI" HintPath="$(RevitDir)\RevitAPI.dll" Private="false" />
    <Reference Include="RevitAPIUI" HintPath="$(RevitDir)\RevitAPIUI.dll" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Gordium.Worker/Gordium.Worker.csproj" />
  </ItemGroup>
</Project>
