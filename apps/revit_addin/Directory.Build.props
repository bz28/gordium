<Project>
  <PropertyGroup>
    <!-- Revit 2027 runs add-ins on .NET 10 (Autodesk's Revit 2027 "What's new": "Migrating Revit to .NET 10");
         Revit 2025 and 2026 are built on .NET 8, and Autodesk plans to move them to .NET 10 (Autodesk's blog,
         "Call for Preview Testing: Revit 2026/2025 Migration to .NET 10", 2026-04-29). So both are built and
         tested, and the Windows trial confirms which one the installed Revit runs (apps/revit_addin/README.md) -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- packages restore only from the versions pinned here, the same on every machine -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
</Project>
